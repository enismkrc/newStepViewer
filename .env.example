# ============================================================
#  HMS 3D Viewer — Ortam Değişkenleri (örnek)
#  Bu dosyayı ".env" adıyla kopyalayın ve değerleri doldurun.
#  cp .env.example .env   (Windows PowerShell: Copy-Item .env.example .env)
# ============================================================

# --- MOCK MOD ---
# true  : public/mock-api/*.json dosyalarını kullanır (backend gerekmez)
# false : gerçek backend'e gider (aşağıdaki VITE_API_BASE_URL zorunlu olur)
VITE_USE_MOCK_API=true

# --- GERÇEK BACKEND KÖK ADRESİ ---
# Mock kapalıyken (VITE_USE_MOCK_API=false) kullanılır.
# Örn: http://localhost:8080  veya  https://api.sirket.com
VITE_API_BASE_URL=

# --- UYGULAMA BASE PATH (opsiyonel) ---
# Uygulama bir alt yolda sunuluyorsa (örn. https://site.com/hms/) ayarlayın.
# Kökte sunuluyorsa boş bırakın ya da "/" yapın. Vite bunu otomatik okur.
# Not: vite.config.js içindeki `base` ile router otomatik uyumludur.
