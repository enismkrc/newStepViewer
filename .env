# --- Aircraft data source configuration ---
# This machine has no backend, so we use the mock JSON API (public/mock-api/aircraft.json).
VITE_USE_MOCK_API=true

# When the real backend is ready, set the line above to false and put its address here,
# e.g. VITE_API_BASE_URL=http://localhost:8080
VITE_API_BASE_URL=
